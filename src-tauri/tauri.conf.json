{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PasteCompiler",
  "version": "0.1.0",
  "identifier": "com.pastecompiler.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PasteCompiler",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Convert anything you copied into the format you need",
    "longDescription": "PasteCompiler detects the format of whatever is on your clipboard (tables, JSON, CSV, YAML, text ...) and converts it to the format you need, checking for data loss along the way. Define reusable conversion recipes in natural language and share them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
